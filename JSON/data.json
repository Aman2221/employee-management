    "faqs" : [
      {
        "question": "How can I apply for a leave?",
        "answer": "To apply for a leave, log in to your account, navigate to the 'Apply Leave' section, fill out the leave application form, and click 'Submit'."
      },
      {
        "question": "Can I cancel or modify my leave application after submission?",
        "answer": "Yes, you can cancel or modify your leave application before it is approved by the manager. Go to 'My Leaves' and select the leave you want to cancel or edit."
      },
      {
        "question": "How do I check my leave balance?",
        "answer": "You can check your leave balance on the 'Leave Balance' page, which displays the remaining leaves for each leave type."
      },
      {
        "question": "What happens if my leave request is rejected?",
        "answer": "If your leave request is rejected, you will receive a notification via email or in-app, and the leave will not be deducted from your balance."
      },
      {
        "question": "Can I apply for multiple leaves at once?",
        "answer": "Yes, you can apply for multiple leaves by specifying the leave dates and types in the 'Apply Leave' form."
      },
      {
        "question": "How do I know if my leave is approved?",
        "answer": "You will receive an email notification and an in-app notification once your leave is approved by the manager."
      },
      {
        "question": "What is the difference between planned and unplanned leaves?",
        "answer": "Planned leaves are those you apply for in advance, while unplanned leaves are typically for emergencies and require immediate approval."
      },
      {
        "question": "Can I view my leave history?",
        "answer": "Yes, you can view your leave history in the 'My Leaves' section, where all past leave applications and their statuses are listed."
      },
      {
        "question": "Who can approve or reject my leave request?",
        "answer": "Your leave request is approved or rejected by your assigned manager or supervisor. You can see their name in the approval flow."
      },
      {
        "question": "What should I do if I face issues with the leave application process?",
        "answer": "If you encounter any issues, you can contact the HR team or use the 'Support' section in the app to raise a ticket."
      }
    ],
